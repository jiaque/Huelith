{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-base", "hidden": true, "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT}",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "VCPKG_INSTALL_OPTIONS": "--x-buildtrees-root=${sourceDir}/build/vcpkg-buildtrees;--x-packages-root=${sourceDir}/build/vcpkg-packages",
        "VCPKG_TARGET_TRIPLET": "x64-windows", "BUILD_TESTING": "ON"
      },
      "environment": {
        "VCPKG_DOWNLOADS": "${sourceDir}/build/vcpkg-downloads",
        "VCPKG_BINARY_SOURCES": "clear;files,${sourceDir}/build/vcpkg-cache,readwrite"
      }
    },
    {"name": "windows-debug", "inherits": "windows-base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "windows-release", "inherits": "windows-base", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "windows-asan", "inherits": "windows-base", "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "HUELITH_ENABLE_ASAN": "ON"}}
  ],
  "buildPresets": [
    {"name": "windows-debug", "configurePreset": "windows-debug"},
    {"name": "windows-release", "configurePreset": "windows-release"},
    {"name": "windows-asan", "configurePreset": "windows-asan"}
  ],
  "testPresets": [
    {"name": "windows-debug", "configurePreset": "windows-debug", "output": {"outputOnFailure": true}},
    {"name": "windows-release", "configurePreset": "windows-release", "output": {"outputOnFailure": true}},
    {"name": "windows-asan", "configurePreset": "windows-asan", "output": {"outputOnFailure": true}}
  ]
}
